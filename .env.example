# VITE_API_URL: URL base del backend real (Spring Boot) del proyecto Fábrica Escuela.
# En local, levanta el backend (mvn spring-boot:run) y usa http://localhost:8080.
# En producción (Vercel), configúrala con la URL de Render, por ejemplo:
# https://ebv13-agenda-reservas.onrender.com
VITE_API_URL="http://localhost:8080"
